static void aHNW_setupAction(HANIWA_ACTOR* haniwa, GAME* game, int action);

static int aHNW_set_save_permission() {
    u32 player_no = Common_Get(player_no);
    PersonalID_c* pid;
    mHm_hs_c* house;
    int res = FALSE;

    if (player_no < PLAYER_NUM) {
        int arrange_idx = mHS_get_arrange_idx(player_no);
        house = Save_GetPointer(homes[arrange_idx]);
        pid = &Save_Get(private_data[player_no]).player_ID;

        if (mPr_NullCheckPersonalID(pid) != TRUE && mPr_CheckCmpPersonalID(pid, &house->ownerID) == TRUE) {
            res = TRUE;
            house->flags.has_saved = TRUE;
        }
    }

    return res;
}

static void aHNW_search_player(HANIWA_ACTOR* haniwa) {
    chase_angle(&((ACTOR*)haniwa)->shape_info.rotation.y, ((ACTOR*)haniwa)->player_angle_y, 0x0600);
}

static void aHNW_search_front(HANIWA_ACTOR* haniwa, int house_idx) {
    s16 target_angle[mHS_HOUSE_NUM] = { 8000, -8000, 8000, -8000 };

    chase_angle(&haniwa->common_actor_class.actor_class.shape_info.rotation.y, target_angle[house_idx], 0x0600);
}

static int aHNW_check_keep_item(HANIWA_ACTOR* haniwa) {
    Haniwa_Item_c* haniwa_item = Save_Get(homes[haniwa->house_idx]).haniwa.items;
    int i;
    int res = FALSE;

    for (i = 0; i < HANIWA_ITEM_HOLD_NUM; i++) {
        if (haniwa_item->item != EMPTY_NO) {
            res = TRUE;
            break;
        }

        haniwa_item++;
    }

    return res;
}

static void aHNW_set_proceeds_str(Haniwa_c* haniwa) {
    u8 str[7];

    mFont_UnintToString(str, 7, haniwa->bells, 6, TRUE, FALSE, TRUE);
    mMsg_SET_FREE_STR(mMsg_FREE_STR0, str, sizeof(str));
}

static int aHNW_check_handOver_proceeds(Haniwa_c* haniwa) {
    int handOver = FALSE;
    u32 money = Common_Get(now_private)->inventory.wallet + haniwa->bells;

    if (money < mPr_WALLET_MAX) {
        Common_Get(now_private)->inventory.wallet = money;
        handOver = TRUE;
    } else {
        u32 num_30k_bell_bags = (money - mPr_WALLET_MAX) / 30000 + 1;

        if (mPr_GetPossessionItemSumWithCond(Common_Get(now_private), EMPTY_NO, mPr_ITEM_COND_NORMAL) >=
            num_30k_bell_bags) {
            handOver = TRUE;

            for (num_30k_bell_bags; num_30k_bell_bags != 0; num_30k_bell_bags--) {
                mPr_SetFreePossessionItem(Common_Get(now_private), ITM_MONEY_30000, mPr_ITEM_COND_NORMAL);
                money -= 30000;
            }

            Common_Get(now_private)->inventory.wallet = money;
        } else {
            u8 str[5];

            mFont_UnintToString(str, 5, num_30k_bell_bags, 5, TRUE, FALSE, TRUE);
            mMsg_SET_FREE_STR(mMsg_FREE_STR1, str, sizeof(str));
        }
    }

    return handOver;
}

static int aHNW_check_house_door(ACTOR* actor, GAME_PLAY* play) {
    int res = FALSE;

    if (Common_Get(reset_flag) == TRUE) {
        ACTOR* talk_actor = mDemo_Get_talk_actor();

        if (talk_actor == NULL && chkTrigger(BUTTON_A)) {
            ACTOR* playerx = GET_PLAYER_ACTOR_ACTOR(play);

            if (mDemo_Check_DiffAngle_forTalk((actor->player_angle_y - playerx->shape_info.rotation.y) +
                                              DEG2SHORT_ANGLE2(180.0f)) == TRUE) {
                Common_Set(reset_type, 4);
            }
        }

        res = TRUE;
    } else {
        mDemo_Clip_c* demo_clip = Common_Get(clip).demo_clip;

        if (demo_clip != NULL) {
            INTRO_DEMO_ACTOR* demo_class = (INTRO_DEMO_ACTOR*)demo_clip->demo_class;
            if (demo_class != NULL && demo_clip->type == mDemo_CLIP_TYPE_INTRO_DEMO && mEv_CheckFirstIntro() &&
                demo_class->player_intro_demo_state != 0) {
                res = TRUE;
            }
        }
    }

    return res;
}

static void aHNW_wait(HANIWA_ACTOR* haniwa, GAME* game) {
    if (haniwa->common_actor_class.actor_class.player_distance_xz < 80.0f) {
        aHNW_setupAction(haniwa, game, aHNW_ACTION_DANCE);
    }
}

#if defined(TARGET_PC) || defined(TARGET_SERVER)
static int s_movein_house_idx = 0;
static int s_movein_had_prior_owner = 0;
static char s_movein_prior_owner_name[PLAYER_NAME_LEN + 1] = { 0 };

void pc_set_movein_dialogue_house(int house_idx) {
    s_movein_house_idx = house_idx;
}

void pc_set_movein_prior_owner(int had_prior_owner, const char* name) {
    s_movein_had_prior_owner = had_prior_owner;
    memset(s_movein_prior_owner_name, 0, sizeof(s_movein_prior_owner_name));
    if (name != NULL) {
        strncpy(s_movein_prior_owner_name, name, PLAYER_NAME_LEN);
        s_movein_prior_owner_name[PLAYER_NAME_LEN] = '\0';
    }
}

int pc_load_custom_msg(mMsg_Data_c* msg_data, int index, int cut) {
    if (msg_data == NULL) {
        return FALSE;
    }

    if (index == MSG_PC_MOVEIN_SUCCESS) {
        u8* buf = msg_data->text_buf.data;
        int pos = 0;
        if (s_movein_had_prior_owner) {
            const char* l1 = "I'm moving in";
            const char* l2_pfx = "with ";
            const char* l2_sfx = "!";
            while (*l1) buf[pos++] = (u8)(*l1++);
            buf[pos++] = CHAR_NEW_LINE;
            while (*l2_pfx) buf[pos++] = (u8)(*l2_pfx++);
            for (int i = 0; s_movein_prior_owner_name[i] != '\0'; i++) {
                buf[pos++] = (u8)s_movein_prior_owner_name[i];
            }
            while (*l2_sfx) buf[pos++] = (u8)(*l2_sfx++);
        } else {
            const char* l1 = "I'm moving in!";
            while (*l1) buf[pos++] = (u8)(*l1++);
        }

        buf[pos++] = CHAR_CONTROL_CODE;
        buf[pos++] = mFont_CONT_CODE_LAST;

        while (pos < mMsg_MSG_BUF_MAX) {
            buf[pos++] = 0;
        }
        return TRUE;
    }

    if (index != MSG_PC_MOVEIN_FLOW) {
        return FALSE;
    }

    u8* buf = msg_data->text_buf.data;
    int pos = 0;
    int house_idx = s_movein_house_idx;
    if (house_idx < 0 || house_idx >= mHS_HOUSE_NUM) {
        house_idx = 0;
    }

    /* Page 1: Would you like to select this house? */
    const char* p1_line1 = "Would you like to select";
    const char* p1_line2 = "this house?";
    while (*p1_line1) buf[pos++] = (u8)(*p1_line1++);
    buf[pos++] = CHAR_NEW_LINE;
    while (*p1_line2) buf[pos++] = (u8)(*p1_line2++);

    /* Pause for button press (0x7F 0x04) + clear window (0x7F 0x02) */
    buf[pos++] = CHAR_CONTROL_CODE;
    buf[pos++] = mFont_CONT_CODE_BUTTON;
    buf[pos++] = CHAR_CONTROL_CODE;
    buf[pos++] = mFont_CONT_CODE_CLEAR;

    /* Page 2: Occupancy status */
    if (mPr_NullCheckPersonalID(&Save_Get(homes[house_idx]).ownerID) == TRUE) {
        const char* p2_line1 = "Nobody lives in this house";
        const char* p2_line2 = "right now! It is vacant.";
        while (*p2_line1) buf[pos++] = (u8)(*p2_line1++);
        buf[pos++] = CHAR_NEW_LINE;
        while (*p2_line2) buf[pos++] = (u8)(*p2_line2++);
    } else {
        char owner_name[PLAYER_NAME_LEN + 1];
        int name_len = 0;
        memset(owner_name, 0, sizeof(owner_name));
        for (int i = 0; i < PLAYER_NAME_LEN; i++) {
            u8 c = Save_Get(homes[house_idx]).ownerID.player_name[i];
            if (c == 0 || c == CHAR_SPACE) break;
            owner_name[name_len++] = (char)c;
        }
        if (name_len == 0) {
            snprintf(owner_name, sizeof(owner_name), "Someone");
        }
        const char* p2_pfx = "This is ";
        const char* p2_sfx = "'s house.";
        const char* p2_line2 = "A roommate slot is open!";
        while (*p2_pfx) buf[pos++] = (u8)(*p2_pfx++);
        for (int i = 0; owner_name[i] != '\0'; i++) buf[pos++] = (u8)owner_name[i];
        while (*p2_sfx) buf[pos++] = (u8)(*p2_sfx++);
        buf[pos++] = CHAR_NEW_LINE;
        while (*p2_line2) buf[pos++] = (u8)(*p2_line2++);
    }

    /* Pause for button press (0x7F 0x04) + clear window (0x7F 0x02) */
    buf[pos++] = CHAR_CONTROL_CODE;
    buf[pos++] = mFont_CONT_CODE_BUTTON;
    buf[pos++] = CHAR_CONTROL_CODE;
    buf[pos++] = mFont_CONT_CODE_CLEAR;

    /* Page 3: "Do you want to move in?" with Choice Window */
    const char* p3_line = "Do you want to move in?";
    while (*p3_line) buf[pos++] = (u8)(*p3_line++);

    /* Choice Window popup (0x7F 0x0D) + end of message (0x7F 0x00) */
    buf[pos++] = CHAR_CONTROL_CODE;
    buf[pos++] = mFont_CONT_CODE_SET_SELECT_WINDOW;
    buf[pos++] = CHAR_CONTROL_CODE;
    buf[pos++] = mFont_CONT_CODE_LAST;

    /* Fill remainder of buffer with 0 */
    while (pos < mMsg_MSG_BUF_MAX) {
        buf[pos++] = 0;
    }

    return TRUE;
}
#endif

static int aHNW_decide_msg_idx_dance(HANIWA_ACTOR* haniwa) {
    Haniwa_c* house_haniwa;
    int house_idx = haniwa->house_idx;
    int player_is_owner = FALSE;
    int res;

#if defined(TARGET_PC)
    bool player_has_house = FALSE;

    /* Check local save data: does current player match house owner, or own another house? */
    if (Common_Get(now_private) != NULL && !mPr_NullCheckPersonalID(&Common_Get(now_private)->player_ID)) {
        if (!mPr_NullCheckPersonalID(&Save_Get(homes[house_idx]).ownerID) &&
            mPr_CheckCmpPersonalID(&Save_Get(homes[house_idx]).ownerID, &Common_Get(now_private)->player_ID) == TRUE) {
            player_is_owner = TRUE;
            player_has_house = TRUE;
        }
        for (int h = 0; h < mHS_HOUSE_NUM; h++) {
            if (!mPr_NullCheckPersonalID(&Save_Get(homes[h]).ownerID) &&
                mPr_CheckCmpPersonalID(&Save_Get(homes[h]).ownerID, &Common_Get(now_private)->player_ID) == TRUE) {
                player_has_house = TRUE;
                break;
            }
        }
    }

    /* Check network resident status if connected */
    if (client_network_is_connected() && client_network_is_resident()) {
        if (client_network_get_house_idx() == house_idx) {
            player_is_owner = TRUE;
        }
        player_has_house = TRUE;
    }
#else
    player_is_owner = (Common_Get(player_no) == mHS_get_pl_no(haniwa->house_idx));
#endif

    if (mPr_NullCheckPersonalID(&Save_Get(homes[house_idx]).ownerID) == TRUE) {
#if defined(TARGET_PC)
        /* If player is unhoused and house is vacant, offer move in */
        if (!player_has_house) {
            res = aHNW_MSG_MOVE_IN;
        } else {
            res = aHNW_MSG_NO_OWNER;
        }
#else
        res = aHNW_MSG_NO_OWNER; /* no one owns this house */
#endif
    } else if (player_is_owner == TRUE) {
        Haniwa_c* house_haniwa = &Save_Get(homes[house_idx]).haniwa;
        mHm_hs_c* house = Save_GetPointer(homes[house_idx]);
#if !defined(TARGET_PC)
        int house_arrange_idx = mHS_get_arrange_idx(Common_Get(player_no));
        house = Save_GetPointer(homes[house_arrange_idx]);
        if (house->flags.has_saved == FALSE && mEv_CheckFirstJob() == TRUE &&
            mNpc_GetFriendAnimalNum(&Common_Get(now_private)->player_ID) == 0) {
            res =
                aHNW_MSG_NEED_FRIEND; /* player owns this house, but is in intro and has not spoken to any villagers */
        } else
#endif
        if (house_haniwa->bells != 0) {
            res = aHNW_MSG_PROCEEDS;
        } else {
            res = aHNW_MSG_NORMAL;
        }

        /* player owns house but gyroid has bells from other players */
    } else {
#if defined(TARGET_PC)
        /* Check if visitor can move in as a roommate */
        if (!player_has_house && mHS_get_roommate_vacancies(house_idx) > 0) {
            res = aHNW_MSG_MOVE_IN;
        } else {
            res = aHNW_MSG_OTHER_OWNER; /* another player owns house */
        }
#else
        res = aHNW_MSG_OTHER_OWNER; /* another player owns house */
#endif
    }

    return res;
}

static void aHNW_set_talk_info_dance(ACTOR* actor) {
    static int msg_no[aHNW_MSG_NUM] = {
        MSG_2356, /* aHNW_MSG_NO_OWNER */
        MSG_2357, /* aHNW_MSG_PROCEEDS */
        MSG_2341, /* aHNW_MSG_NORMAL */
        MSG_2344, /* aHNW_MSG_OTHER_OWNER */
        MSG_2350, /* aHNW_MSG_NEED_FRIEND */
#if defined(TARGET_PC) || defined(TARGET_SERVER)
        MSG_PC_MOVEIN_FLOW /* aHNW_MSG_MOVE_IN */
#endif
    };

    HANIWA_ACTOR* haniwa = (HANIWA_ACTOR*)actor;
    int house_idx = haniwa->house_idx;
    Haniwa_c* house_haniwa = &Save_Get(homes[house_idx]).haniwa;
    int msg_idx = aHNW_decide_msg_idx_dance(haniwa);

    switch (msg_idx) {
        case aHNW_MSG_PROCEEDS: {
            aHNW_set_proceeds_str(house_haniwa);
            break;
        }

        case aHNW_MSG_OTHER_OWNER: {
            mMsg_Set_mail_str(mMsg_Get_base_window_p(), 0, house_haniwa->message, HANIWA_MESSAGE_LEN);
            break;
        }

#if defined(TARGET_PC)
        case aHNW_MSG_MOVE_IN: {
            mChoice_c* choice_win = mChoice_Get_base_window_p();
            static u8 str_yes[mChoice_CHOICE_STRING_LEN] = "Yes";
            static u8 str_no[mChoice_CHOICE_STRING_LEN]  = "No";
            mChoice_Set_choice_data(choice_win,
                str_yes, (int)strlen((char*)str_yes),
                str_no,  (int)strlen((char*)str_no),
                NULL, 0, NULL, 0, NULL, 0, NULL, 0);
            mChoice_no_b_set(choice_win);
            mChoice_Clear_ChoseNum(choice_win);
            pc_set_movein_dialogue_house(house_idx);
            break;
        }
#endif
    }

    mDemo_Set_msg_num(msg_no[msg_idx]);
}

static void aHNW_dance(HANIWA_ACTOR* haniwa, GAME* game) {
    static int next_act_idx[aHNW_MSG_NUM] = {
        aHNW_ACTION_TALK_END_WAIT,    /* aHNW_MSG_NO_OWNER */
        aHNW_ACTION_CHECK_PROCEEDS,   /* aHNW_MSG_PROCEEDS */
        aHNW_ACTION_TALK_WITH_MASTER, /* aHNW_MSG_NORMAL */
        aHNW_ACTION_TALK_WITH_GUEST,  /* aHNW_MSG_OTHER_OWNER */
        aHNW_ACTION_TALK_END_WAIT,    /* aHNW_MSG_NEED_FRIEND */
#if defined(TARGET_PC) || defined(TARGET_SERVER)
        aHNW_ACTION_MOVE_IN_CHECK     /* aHNW_MSG_MOVE_IN */
#endif
    };

    ACTOR* actorx = (ACTOR*)haniwa;

    if (((ACTOR*)haniwa)->player_distance_xz > 90.0f) {
        aHNW_setupAction(haniwa, game, aHNW_ACTION_WAIT);
    } else {
        if (mDemo_Check(mDemo_TYPE_TALK, actorx) == TRUE && mDemo_Check_ListenAble() == FALSE) {
            int msg_idx = aHNW_decide_msg_idx_dance(haniwa);

            mDemo_Set_ListenAble();
            aHNW_setupAction(haniwa, game, next_act_idx[msg_idx]);
        } else if (aHNW_check_house_door(actorx, (GAME_PLAY*)game) == FALSE) {
            mDemo_Request(mDemo_TYPE_TALK, actorx, &aHNW_set_talk_info_dance);
        }
    }
}

static void aHNW_check_proceeds(HANIWA_ACTOR* haniwa, GAME* game) {
    static int msg_no[aHNW_HANDOVER_NUM] = {
        0x0936, /* aHNW_HANDOVER_YES */
        0x0937  /* aHNW_HANDOVER_NO */
    };

    static int next_act_idx[aHNW_HANDOVER_NUM] = {
        aHNW_ACTION_TALK_WITH_MASTER, /* aHNW_HANDOVER_YES */
        aHNW_ACTION_TALK_END_WAIT     /* aHNW_HANDOVER_NO */
    };

    if (mDemo_Get_OrderValue(mDemo_ORDER_NPC0, 9)) {
        int house_idx = haniwa->house_idx;
        Haniwa_c* house_haniwa = &Save_Get(homes[house_idx]).haniwa;
        int handover_state;

        if (aHNW_check_handOver_proceeds(house_haniwa) == TRUE) {
            house_haniwa->bells = 0;
            handover_state = aHNW_HANDOVER_YES;
        } else {
            handover_state = aHNW_HANDOVER_NO;
        }

        mMsg_SET_CONTINUE_MSG_NUM(msg_no[handover_state]);
        aHNW_setupAction(haniwa, game, next_act_idx[handover_state]);
        mDemo_Set_OrderValue(mDemo_ORDER_NPC0, 9, 0);
    }
}

static void aHNW_talk_with_master(HANIWA_ACTOR* haniwa, GAME* game) {
    mMsg_Window_c* msg_win = mMsg_Get_base_window_p();

    if (mDemo_Get_OrderValue(mDemo_ORDER_NPC0, 9) && mMsg_Check_MainNormalContinue(msg_win) == TRUE) {
        int action = -1;

        switch (mChoice_GET_CHOSENUM()) {
            case mChoice_CHOICE0: {
                action = aHNW_ACTION_SAVE_CHECK;
                break;
            }

            case mChoice_CHOICE1: {
                action = aHNW_ACTION_MENU_OPEN_WAIT;
                haniwa->submenu_type = mSM_OVL_INVENTORY;
                break;
            }

            case mChoice_CHOICE2: {
                action = aHNW_ACTION_TALK_WITH_MASTER2;
                break;
            }

            case mChoice_CHOICE3: {
                action = aHNW_ACTION_TALK_END_WAIT;
                break;
            }
        }

        if (action != -1) {
            mDemo_Set_OrderValue(mDemo_ORDER_NPC0, 9, 0);
            aHNW_setupAction(haniwa, game, action);
        }
    }
}

static void aHNW_talk_with_master2(HANIWA_ACTOR* haniwa, GAME* game) {
    mMsg_Window_c* msg_win = mMsg_Get_base_window_p();

    if (mDemo_Get_OrderValue(mDemo_ORDER_NPC0, 9) && mMsg_Check_MainNormalContinue(msg_win) == TRUE) {
        int action = -1;

        switch (mChoice_GET_CHOSENUM()) {
            case mChoice_CHOICE0: {
                action = aHNW_ACTION_ROOF_CHECK;
                break;
            }

            case mChoice_CHOICE1: {
                action = aHNW_ACTION_MENU_OPEN_WAIT;
                haniwa->submenu_type = mSM_OVL_HBOARD;
                break;
            }

            case mChoice_CHOICE2: {
                action = aHNW_ACTION_TALK_WITH_MASTER;
                break;
            }

            case mChoice_CHOICE3: {
                action = aHNW_ACTION_TALK_END_WAIT;
                break;
            }
        }

        if (action != -1) {
            mDemo_Set_OrderValue(mDemo_ORDER_NPC0, 9, 0);
            aHNW_setupAction(haniwa, game, action);
        }
    }
}

static void aHNW_talk_end_wait(HANIWA_ACTOR* haniwa, GAME* game) {
    if (mDemo_Check(mDemo_TYPE_TALK, (ACTOR*)haniwa) == FALSE) {
#if defined(TARGET_PC) || defined(TARGET_SERVER)
        if (Common_Get(complete_payment_type) == mPlayer_COMPLETE_PAYMENT_TYPE_MOVE_IN) {
            if (pc_request_main_complete_payment(game)) {
                aHNW_setupAction(haniwa, game, aHNW_ACTION_DANCE);
            }
            return;
        }
#endif
        aHNW_setupAction(haniwa, game, aHNW_ACTION_DANCE);
    }
}

static void aHNW_menu_open_wait(HANIWA_ACTOR* haniwa, GAME* game) {
    mMsg_Window_c* msg_win = mMsg_Get_base_window_p();

    if (mMsg_Check_main_wait(msg_win) == TRUE) {
        int submenu_type = haniwa->submenu_type;
        Submenu* submenu = &((GAME_PLAY*)game)->submenu;
        int arg1 = haniwa->house_idx;

        switch (submenu_type) {
            case mSM_OVL_HBOARD: {
                mSM_open_submenu(submenu, mSM_OVL_HBOARD, 0, arg1);
                break;
            }

            case mSM_OVL_INVENTORY: {
                mSM_open_submenu(submenu, mSM_OVL_INVENTORY, mSM_IV_OPEN_HANIWA_ENTRUST, arg1);
                break;
            }

            case mSM_OVL_NEEDLEWORK: {
                mSM_open_submenu(submenu, mSM_OVL_NEEDLEWORK, mNW_OPEN_DESIGN, arg1);
                break;
            }
        }

        mMsg_ChangeMsgData(msg_win, 0x0927);
        mMsg_Set_ForceNext(msg_win);
        aHNW_setupAction(haniwa, game, aHNW_ACTION_MENU_END_WAIT);
    }
}

static void aHNW_menu_end_wait(HANIWA_ACTOR* haniwa, GAME* game) {
    Submenu* submenu = &((GAME_PLAY*)game)->submenu;
    Submenu_Item_c* item;

    if (submenu->open_flag == FALSE) {
        if (mMsg_CHECK_NOT_SERIES_MAIN_WAIT() == TRUE) {
            aHNW_setupAction(haniwa, game, aHNW_ACTION_TALK_WITH_MASTER);
            switch (haniwa->submenu_type) {
                case mSM_OVL_NEEDLEWORK: {
                    Submenu_Item_c* item = submenu->item_p;
                    if (item->item == RSV_NO) {
                        Save_Get(homes[haniwa->house_idx]).door_original = mNW_get_image_no(submenu, item->slot_no);
                        sAdo_SysTrgStart(NA_SE_461);
                    }

                    break;
                }
            }

            haniwa->submenu_type = mSM_OVL_NONE;
        }
    }
}

static void aHNW_talk_with_guest(HANIWA_ACTOR* haniwa, GAME* game) {
    if (mDemo_Get_OrderValue(mDemo_ORDER_NPC0, 0)) {
        mMsg_Window_c* msg_win = mMsg_Get_base_window_p();
        if (mMsg_Check_MainNormalContinue(msg_win) == TRUE) {
            int action = -1;

            switch (mChoice_GET_CHOSENUM()) {
                case mChoice_CHOICE0: {
                    if (aHNW_check_keep_item(haniwa) == FALSE) {
                        mMsg_Set_continue_msg_num(msg_win, 0x092C);
                        action = aHNW_ACTION_TALK_END_WAIT;
                    } else {
                        action = aHNW_ACTION_MENU_OPEN_WAIT_FOR_GUEST;
                    }
                    break;
                }

                case mChoice_CHOICE1: {
                    mMsg_Set_continue_msg_num(msg_win, 0x092A);
                    action = aHNW_ACTION_TALK_END_WAIT;
                    break;
                }
            }

            if (action != -1) {
                mDemo_Set_OrderValue(mDemo_ORDER_NPC0, 0, 0);
                aHNW_setupAction(haniwa, game, action);
            }
        }
    }
}

static void aHNW_menu_open_wait_for_guest(HANIWA_ACTOR* haniwa, GAME* game) {
    mMsg_Window_c* msg_win = mMsg_Get_base_window_p();

    if (mMsg_Check_main_wait(msg_win) == TRUE) {
        Submenu* submenu = &((GAME_PLAY*)game)->submenu;

        mSM_open_submenu(submenu, mSM_OVL_INVENTORY, mSM_IV_OPEN_HANIWA_TAKE, haniwa->house_idx);
        mMsg_ChangeMsgData(msg_win, 0x092B);
        aHNW_setupAction(haniwa, game, aHNW_ACTION_MENU_END_WAIT_FOR_GUEST);
    }
}

static void aHNW_menu_end_wait_for_guest(HANIWA_ACTOR* haniwa, GAME* game) {
    Submenu* submenu = &((GAME_PLAY*)game)->submenu;

    if (!submenu->open_flag && mMsg_CHECK_NOT_SERIES_MAIN_WAIT() == TRUE) {
        aHNW_setupAction(haniwa, game, aHNW_ACTION_TALK_END_WAIT);
    }
}

static void aHNW_save_check(HANIWA_ACTOR* haniwa, GAME* game) {
    mMsg_Window_c* msg_win = mMsg_Get_base_window_p();
    int order_value = mDemo_Get_OrderValue(mDemo_ORDER_NPC0, 9);
    int action = -1;

    if (order_value && mMsg_Check_MainNormalContinue(msg_win) == TRUE) {
        switch (mChoice_GET_CHOSENUM()) {
            case mChoice_CHOICE0: {
                action = aHNW_ACTION_SAVE_END_WAIT;
                mBGMPsComp_scene_mode(13);
                mDemo_Set_talk_return_demo_wait(TRUE);
                mPlib_Set_able_force_speak_label((ACTOR*)haniwa);
                break;
            }

            case mChoice_CHOICE1: {
                action = aHNW_ACTION_TALK_WITH_MASTER;
                break;
            }
        }

        if (action != -1) {
            mDemo_Set_OrderValue(mDemo_ORDER_NPC0, 9, 0);
            aHNW_setupAction(haniwa, game, action);
        }
    }
}

static void aHNW_roof_check(HANIWA_ACTOR* haniwa, GAME* game) {
    mMsg_Window_c* msg_win = mMsg_Get_base_window_p();
    int order_value = mDemo_Get_OrderValue(mDemo_ORDER_NPC0, 9);
    int action = -1;

    if (order_value && mMsg_Check_MainNormalContinue(msg_win) == TRUE) {
        switch (mChoice_GET_CHOSENUM()) {
            case mChoice_CHOICE0: {
                action = aHNW_ACTION_MENU_OPEN_WAIT;
                haniwa->submenu_type = mSM_OVL_NEEDLEWORK;
                break;
            }

            case mChoice_CHOICE1: {
                Save_Get(homes[haniwa->house_idx]).door_original = 0xFF;
                sAdo_SysTrgStart(0x461);
                action = aHNW_ACTION_TALK_WITH_MASTER;
                break;
            }

            case mChoice_CHOICE2: {
                action = aHNW_ACTION_TALK_WITH_MASTER;
                break;
            }
        }

        if (action != -1) {
            mDemo_Set_OrderValue(mDemo_ORDER_NPC0, 9, 0);
            aHNW_setupAction(haniwa, game, action);
        }
    }
}

#if defined(TARGET_PC) || defined(TARGET_SERVER)
static void aHNW_move_in_check(HANIWA_ACTOR* haniwa, GAME* game) {
    int choice_no = mChoice_GET_CHOSENUM();
    int action = -1;

    if (choice_no != -1) {
        mChoice_CLEAR_CHOSENUM();
        switch (choice_no) {
            case mChoice_CHOICE0: { /* "Yes" - Claim house */
                int house_idx = haniwa->house_idx;

                int had_prior_owner = 0;
                char prior_name[PLAYER_NAME_LEN + 1];
                memset(prior_name, 0, sizeof(prior_name));

                if (!mPr_NullCheckPersonalID(&Save_Get(homes[house_idx]).ownerID) &&
                    (Common_Get(now_private) == NULL ||
                     mPr_CheckCmpPersonalID(&Save_Get(homes[house_idx]).ownerID, &Common_Get(now_private)->player_ID) == FALSE)) {
                    had_prior_owner = 1;
                    int name_len = 0;
                    for (int i = 0; i < PLAYER_NAME_LEN; i++) {
                        u8 c = Save_Get(homes[house_idx]).ownerID.player_name[i];
                        if (c == 0 || c == CHAR_SPACE) break;
                        prior_name[name_len++] = (char)c;
                    }
                    if (name_len == 0) {
                        snprintf(prior_name, sizeof(prior_name), "Someone");
                    }
                }
                pc_set_movein_prior_owner(had_prior_owner, prior_name);

#ifdef TARGET_PC
                if (client_network_is_connected()) {
                    client_network_send_movein_req((uint8_t)house_idx);
                }
                client_network_set_local_resident((uint8_t)house_idx);
#endif

                if (Common_Get(now_private) != NULL) {
                    mHS_assign_roommate(house_idx, &Common_Get(now_private)->player_ID);
                    mHS_set_use(Common_Get(player_no), house_idx);
                    Common_Set(now_home, house_idx);
                    mHm_SetNowHome();
                    Save_Get(homes[house_idx]).flags.has_saved = TRUE;
                    mPr_SetItemCollectBit(Now_Private->cloth.item);
                    mPr_SetItemCollectBit(FTR_START(FTR_SUM_CASSE01));
                    mPr_SetItemCollectBit(ITM_CARPET_START + Save_Get(homes[house_idx]).floors[0].wall_floor.flooring_idx);
                    mPr_SetItemCollectBit(ITM_WALL_START + Save_Get(homes[house_idx]).floors[0].wall_floor.wallpaper_idx);
                    if (Now_Private->inventory.loan == 0) {
                        Now_Private->inventory.loan = mPlayer_DEBT0;
                    }
                    mEv_ClearPersonalEventFlag(Common_Get(player_no));
                    mEv_UnSetFirstIntro();
                    mEv_UnSetFirstJob();
#if defined(TARGET_PC) || defined(TARGET_SERVER)
                    mBGMPsComp_delete_ps_demo(BGM_INTRO_ARRIVE, 0x168);
                    mBGMPsComp_delete_ps_happening(BGM_INTRO_ARRIVE, 0x168);
                    mBGMPsComp_delete_ps_happening(BGM_INTRO_NEW_TOWN, 0x168);
                    mBGMPsComp_delete_ps_quiet();
                    mBGMPsComp_scene_mode(1);
#endif
                }

                mMsg_REQUEST_MAIN_DISAPPEAR_WAIT_TYPE1();
                action = aHNW_ACTION_TALK_END_WAIT;
                Common_Set(complete_payment_type, mPlayer_COMPLETE_PAYMENT_TYPE_MOVE_IN);
                sAdo_SysTrgStart(0x0461);
                break;
            }

            case mChoice_CHOICE1: { /* "No" - Cancel */
                mMsg_REQUEST_MAIN_DISAPPEAR_WAIT_TYPE1();
                action = aHNW_ACTION_TALK_END_WAIT;
                break;
            }
        }

        if (action != -1) {
            mDemo_Set_OrderValue(mDemo_ORDER_NPC0, 9, 0);
            mDemo_Set_OrderValue(mDemo_ORDER_NPC0, 0, 0);
            aHNW_setupAction(haniwa, game, action);
        }
    } else if (mDemo_Check(mDemo_TYPE_TALK, (ACTOR*)haniwa) == FALSE) {
        aHNW_setupAction(haniwa, game, aHNW_ACTION_DANCE);
    }
}
#endif

static void aHNW_save_end_wait(HANIWA_ACTOR* haniwa, GAME* game) {
    if (haniwa->playing_save_bgm == FALSE && mMsg_CHECK_MAINDISAPPEAR()) {
        haniwa->playing_save_bgm = TRUE;
        mBGMPsComp_make_ps_demo(BGM_ENTER_HOUSE, 0x168);
    }

    if (mDemo_Check(mDemo_TYPE_TALK, (ACTOR*)haniwa) == FALSE) {
        aHNW_setupAction(haniwa, game, aHNW_ACTION_PL_APPROACH_DOOR);
        aHNW_set_save_permission();
    }
}

static void aHNW_pl_approach_door(HANIWA_ACTOR* haniwa, GAME* game) {
    static f32 chk_posX[mHS_HOUSE_NUM] = { 2095.0f, 2385.0f, 2095.0f, 2385.0f };
    static f32 chk_val[mHS_HOUSE_NUM] = { 1.0f, -1.0f, 1.0f, -1.0f };
    static xyz_t goal_pos[mHS_HOUSE_NUM][2] = {
        { { 2098.0f, 0.0f, 1540.0f }, { 2110.0f, 0.0f, 1474.0f } },
        { { 2382.0f, 0.0f, 1540.0f }, { 2369.0f, 0.0f, 1474.0f } },
        { { 2098.0f, 0.0f, 1820.0f }, { 2110.0f, 0.0f, 1755.0f } },
        { { 2382.0f, 0.0f, 1820.0f }, { 2369.0f, 0.0f, 1755.0f } },
    };

    ACTOR* playerx = GET_PLAYER_ACTOR_GAME_ACTOR(game);

#ifdef TARGET_PC
    haniwa->door_approach_frame += graph_dt_60hz_ticks(game, &haniwa->door_approach_accum);
#else
    haniwa->door_approach_frame++;
#endif
    if (playerx != NULL) {
        int house_idx = haniwa->house_idx;
        int stage = ((chk_posX[house_idx] - playerx->world.position.x) * chk_val[house_idx]) <= 0.0f;
        xyz_t* goal = goal_pos[house_idx] + stage;

        if (haniwa->player_approach_door_stage != stage &&
            mPlib_request_main_demo_walk_type1(game, goal->x, goal->z, 3.0f, FALSE)) {
            haniwa->player_approach_door_stage = stage;
        }

        mPlib_Set_goal_player_demo_walk(goal->x, goal->z, 3.0f);

        if (haniwa->door_approach_frame > 160) {
            mActor_name_t house_item = HOUSE0 + haniwa->house_idx;
            MY_HOUSE_ACTOR* house_actor = (MY_HOUSE_ACTOR*)Actor_info_fgName_search(
                &((GAME_PLAY*)game)->actor_info, house_item, ACTOR_PART_ITEM);

            if (house_actor != NULL) {
                house_actor->structure_class.actor_class.world.angle.z = 1;
                aHNW_setupAction(haniwa, game, aHNW_ACTION_WAIT);
            }
        } else if (stage == 1 && search_position_distanceXZ(goal, &playerx->world.position) < 3.0f) {
            aHNW_setupAction(haniwa, game, aHNW_ACTION_DOOR_OPEN_WAIT);
        }
    }
}

static void aHNW_door_open_wait(HANIWA_ACTOR* haniwa, GAME* game) {
    mActor_name_t house_item = HOUSE0 + haniwa->house_idx;
    MY_HOUSE_ACTOR* house_actor =
        (MY_HOUSE_ACTOR*)Actor_info_fgName_search(&((GAME_PLAY*)game)->actor_info, house_item, ACTOR_PART_ITEM);

    if (house_actor != NULL) {
        house_actor->structure_class.request_type = 6; // TODO: this is probably an enum
        if (house_actor != GET_PLAYER_ACTOR_NOW()->get_door_label_proc(gamePT)) {
            aHNW_setupAction(haniwa, game, aHNW_ACTION_DOOR_OPEN_TIMER);
            haniwa->door_approach_frame = 0;
#ifdef TARGET_PC
            haniwa->door_approach_accum = 0.0f;
#endif
        } else {
            aHNW_setupAction(haniwa, game, aHNW_ACTION_WAIT);
        }
    }
}

static void aHNW_door_open_timer(HANIWA_ACTOR* haniwa, GAME* game) {
    mActor_name_t house_item = HOUSE0 + haniwa->house_idx;
    MY_HOUSE_ACTOR* house_actor =
        (MY_HOUSE_ACTOR*)Actor_info_fgName_search(&((GAME_PLAY*)game)->actor_info, house_item, ACTOR_PART_ITEM);

    if (house_actor != NULL) {
        if (house_actor == GET_PLAYER_ACTOR_NOW()->get_door_label_proc(gamePT)) {
            aHNW_setupAction(haniwa, game, aHNW_ACTION_WAIT);
        } else {
#ifdef TARGET_PC
            haniwa->door_approach_frame += graph_dt_60hz_ticks(game, &haniwa->door_approach_accum);
#else
            haniwa->door_approach_frame++;
#endif
            if (haniwa->door_approach_frame > 80) {
                house_actor->structure_class.actor_class.world.angle.z = 1;
                aHNW_setupAction(haniwa, game, aHNW_ACTION_WAIT);
            }
        }
    }
}

static void aHNW_menu_open_wait_init(HANIWA_ACTOR* haniwa, GAME* game) {
    mMsg_REQUEST_MAIN_DISAPPEAR_WAIT_TYPE1();
}

static void aHNW_menu_end_wait_init(HANIWA_ACTOR* haniwa, GAME* game) {
    mMsg_REQUEST_MAIN_APPEAR_WAIT_TYPE1();
}

static void aHNW_talk_with_guest_init(HANIWA_ACTOR* haniwa, GAME* game) {
    PersonalID_c* pid_p = &Save_Get(homes[haniwa->house_idx]).ownerID;
    u8* name_p = pid_p->player_name;

    mMsg_SET_FREE_STR(mMsg_FREE_STR2, name_p, PLAYER_NAME_LEN);
}

static void aHNW_pl_approach_door_init(HANIWA_ACTOR* haniwa, GAME* game) {
    game->pad_initialized = FALSE;
    haniwa->player_approach_door_stage = -1;
    haniwa->door_approach_frame = 0;
#ifdef TARGET_PC
    haniwa->door_approach_accum = 0.0f;
#endif
}

typedef void (*HANIWA_PROC)(HANIWA_ACTOR*, GAME*);

static void aHNW_init_proc(HANIWA_ACTOR* actor, GAME* game, int action) {
    // clang-format off
    static HANIWA_PROC init_proc[aHNW_ACTION_NUM] = {
        (HANIWA_PROC)&none_proc1,
        (HANIWA_PROC)&none_proc1,
        (HANIWA_PROC)&none_proc1,
        (HANIWA_PROC)&none_proc1,
        (HANIWA_PROC)&none_proc1,
        (HANIWA_PROC)&none_proc1,
        &aHNW_menu_open_wait_init,
        &aHNW_menu_end_wait_init,
        &aHNW_talk_with_guest_init,
        &aHNW_menu_open_wait_init,
        &aHNW_menu_end_wait_init,
        (HANIWA_PROC)&none_proc1,
        (HANIWA_PROC)&none_proc1,
        (HANIWA_PROC)&none_proc1,
        &aHNW_pl_approach_door_init,
        (HANIWA_PROC)&none_proc1,
        (HANIWA_PROC)&none_proc1,
#if defined(TARGET_PC) || defined(TARGET_SERVER)
        (HANIWA_PROC)&none_proc1,
#endif
    };
    // clang-format on

    (*init_proc[action])(actor, game);
}

static void aHNW_setupAction(HANIWA_ACTOR* haniwa, GAME* game, int action) {
    static HANIWA_PROC process[aHNW_ACTION_NUM] = {
        &aHNW_wait,
        &aHNW_dance,
        &aHNW_check_proceeds,
        &aHNW_talk_with_master,
        &aHNW_talk_with_master2,
        &aHNW_talk_end_wait,
        &aHNW_menu_open_wait,
        &aHNW_menu_end_wait,
        &aHNW_talk_with_guest,
        &aHNW_menu_open_wait_for_guest,
        &aHNW_menu_end_wait_for_guest,
        &aHNW_roof_check,
        &aHNW_save_check,
        &aHNW_save_end_wait,
        &aHNW_pl_approach_door,
        &aHNW_door_open_wait,
        &aHNW_door_open_timer,
#if defined(TARGET_PC) || defined(TARGET_SERVER)
        &aHNW_move_in_check,
#endif
    };

    int house_idx = haniwa->house_idx;
    int animation_state = haniwa->common_actor_class.anime.anime_no;
    int no_owner = mPr_NullCheckPersonalID(&Save_Get(homes[house_idx]).ownerID);
#if defined(TARGET_PC)
    int owner_is_player = FALSE;
    if (!no_owner && Common_Get(now_private) != NULL && !mPr_NullCheckPersonalID(&Common_Get(now_private)->player_ID)) {
        if (mPr_CheckCmpPersonalID(&Save_Get(homes[house_idx]).ownerID, &Common_Get(now_private)->player_ID) == TRUE) {
            owner_is_player = TRUE;
        }
    }
    if (client_network_is_connected() && client_network_is_resident() &&
        client_network_get_house_idx() == house_idx) {
        owner_is_player = TRUE;
    }
#else
    int owner_is_player = mHS_get_pl_no(house_idx) == Common_Get(player_no);
#endif

    haniwa->common_actor_class.act = action;
    haniwa->action_proc = process[action];

    if (action >= aHNW_ACTION_CHECK_PROCEEDS) {
        haniwa->anim_frame_speed = 0.3f;
    } else {
        if (no_owner) {
            if (haniwa->anim_frame_speed != 0.0f) {
                haniwa->anim_frame_speed = 0.075f;
            }
        } else {
            if (owner_is_player) {
                if (action == aHNW_ACTION_WAIT || action == aHNW_ACTION_DOOR_OPEN_TIMER) {
                    haniwa->anim_frame_speed = 0.3f;
                } else {
                    haniwa->anim_frame_speed = 0.45f;
                }
            } else {
                haniwa->anim_frame_speed = 0.1f;
            }
        }
    }

    if (animation_state == 2) {
        cKF_SkeletonInfo_R_init(&haniwa->common_actor_class.anime.keyframe,
                                haniwa->common_actor_class.anime.keyframe.skeleton, &cKF_ba_r_hnw_move, 1.0f, 9.0f,
                                1.0f, haniwa->anim_frame_speed, 0.0f, cKF_FRAMECONTROL_REPEAT, NULL);
        haniwa->common_actor_class.anime.cur_keyframe =
            haniwa->common_actor_class.anime.keyframe.frame_control.current_frame;
    }

    haniwa->common_actor_class.anime.anime_no = 0;
    aHNW_init_proc(haniwa, game, action);
    if (no_owner && action < aHNW_ACTION_CHECK_PROCEEDS) {
        haniwa->common_actor_class.anime.keyframe.frame_control.mode = cKF_FRAMECONTROL_STOP;
    } else {
        haniwa->common_actor_class.anime.keyframe.frame_control.mode = cKF_FRAMECONTROL_REPEAT;
    }
}

static void aHNW_common_process(ACTOR* actor, GAME* game) {
    HANIWA_ACTOR* haniwa = (HANIWA_ACTOR*)actor;
    cKF_SkeletonInfo_R_c* keyframe = &haniwa->common_actor_class.anime.keyframe;
    int house_idx = haniwa->house_idx;
    int no_owner = mPr_NullCheckPersonalID(&Save_Get(homes[house_idx]).ownerID);
    f32 target;

    if (no_owner == FALSE && keyframe->frame_control.mode == cKF_FRAMECONTROL_STOP) {
        aHNW_setupAction(haniwa, game, haniwa->common_actor_class.act);
        keyframe->frame_control.mode = cKF_FRAMECONTROL_REPEAT;
    } else if (no_owner && haniwa->common_actor_class.act < 2 && keyframe->frame_control.speed <= 0.1f) {
        keyframe->frame_control.mode = cKF_FRAMECONTROL_STOP;
    } else {
        keyframe->frame_control.mode = cKF_FRAMECONTROL_REPEAT;
    }

    if (no_owner == FALSE || haniwa->common_actor_class.act >= aHNW_ACTION_CHECK_PROCEEDS) {
        aHNW_search_player(haniwa);
    } else {
        aHNW_search_front(haniwa, house_idx);
    }

    target = haniwa->anim_frame_speed;

    {
        if (target > keyframe->frame_control.speed) {
            chase_f(&keyframe->frame_control.speed, target, 0.05f);
        } else {
            chase_f(&keyframe->frame_control.speed, target, 0.015f);
        }
    }
}

static void aHNW_actor_move(ACTOR* actor, GAME* game) {
    HANIWA_ACTOR* haniwa = (HANIWA_ACTOR*)actor;
    GAME_PLAY* play = (GAME_PLAY*)game;
    cKF_SkeletonInfo_R_c* keyframe = &haniwa->common_actor_class.anime.keyframe;

    haniwa->common_actor_class.anime.state = cKF_SkeletonInfo_R_play(keyframe);
    (*haniwa->action_proc)(haniwa, game);
    aHNW_common_process(actor, game);
    CollisionCheck_Uty_ActorWorldPosSetPipeC(actor, &haniwa->common_actor_class.col_pipe);
    CollisionCheck_setOC(game, &play->collision_check, &haniwa->common_actor_class.col_pipe.collision_obj);
    Actor_world_to_eye(actor, 50.0f);
}

static void aHNW_actor_init(ACTOR* actor, GAME* game) {
    HANIWA_ACTOR* haniwa = (HANIWA_ACTOR*)actor;
    int house_idx = haniwa->house_idx;

    mFI_SetFG_common((mActor_name_t)(house_idx + DUMMY_HANIWA0), actor->world.position, FALSE);
    actor->mv_proc = &aHNW_actor_move;
    actor->dw_proc = &aHNW_actor_draw;
    aHNW_setupAction(haniwa, game, aHNW_ACTION_WAIT);
    haniwa->common_actor_class.anime.keyframe.morph_counter = 0.0f;
    aHNW_actor_move(actor, game);
}
